sa0 <- st_read(BND_GPKG, layer = BND_LAYER_ADMIN0, quiet = TRUE) %>%
st_make_valid() %>%
st_transform(4326)
# -----------------------------
# 1) READ SETTLEMENTS
# -----------------------------
sett <- st_read(SETT_GPKG, quiet = TRUE)
if (!"settlement_id" %in% names(sett)) {
stop("settlement_id not found in settlements GPKG.")
}
sett_ll <- st_transform(st_make_valid(sett), 4326)
# -----------------------------
# 2) READ DAILY PANEL + AGGREGATE MONTHLY
# -----------------------------
sett_day <- arrow::read_parquet(DAY_PARQ) %>%
mutate(date = as.Date(date)) %>%
filter(date >= MONTH_START, date < MONTH_END)
req_cols <- c("settlement_id", "date", "p_lit_sett", "coverage", "n_valid", "n_lit")
miss <- setdiff(req_cols, names(sett_day))
if (length(miss) > 0) stop("Missing required columns in parquet: ", paste(miss, collapse = ", "))
# Number of calendar days in the selected window (used for availability / missingness diagnostics)
N_DAYS_WINDOW <- as.integer(MONTH_END - MONTH_START)
if (is.na(N_DAYS_WINDOW) || N_DAYS_WINDOW <= 0) {
stop("Invalid MONTH_START/MONTH_END window; MONTH_END must be strictly after MONTH_START.")
}
sett_month <- sett_day %>%
group_by(settlement_id) %>%
summarise(
# Intensity (two equivalent monthly aggregations; see note below)
# - mean_p_lit: simple mean over observed days (each day gets equal weight)
# - p_lit_weighted: ratio of sums across the month (days weighted by n_valid)
mean_p_lit     = mean(p_lit_sett, na.rm = TRUE),
p_lit_weighted = dplyr::if_else(sum(n_valid, na.rm = TRUE) > 0,
sum(n_lit,   na.rm = TRUE) / sum(n_valid, na.rm = TRUE),
NA_real_),
# Observation / data availability
n_days_obs   = sum(!is.na(p_lit_sett)),
share_days_obs = n_days_obs / N_DAYS_WINDOW,
# Coverage / volume proxies
mean_cov     = mean(coverage, na.rm = TRUE),
mean_n_valid = mean(n_valid,  na.rm = TRUE),
# Reliability / stability metrics (Option B style)
# - frac_days_lit: fraction of observed days with p_lit_sett >= LIT_TAU
frac_days_lit = mean(p_lit_sett >= LIT_TAU, na.rm = TRUE),
# - frac_days_any_lit: lenient version (any lit signal that day)
frac_days_any_lit = mean(p_lit_sett > 0, na.rm = TRUE),
# - mean_n_lit: average number of lit pixels (informative but not normalized)
mean_n_lit = mean(n_lit, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
has_any_data = n_days_obs > 0,
# Convenience: expected lit-days over full calendar window (treat unobserved days as missing, not dark)
lit_days_est = frac_days_lit * n_days_obs
)
map_sf <- sett_ll %>%
left_join(sett_month, by = "settlement_id")
if (!SHOW_NO_DATA) {
map_sf <- map_sf %>% filter(has_any_data)
}
# -----------------------------
# SETTLEMENT POPUP (FULL INFO)
# -----------------------------
popup_settlement <- function(df) {
fmt_num <- function(x, digits = 2) {
if (is.null(x) || length(x) == 0 || is.na(x)) "NA" else formatC(as.numeric(x), format = "f", digits = digits)
}
fmt_int <- function(x) {
x <- suppressWarnings(as.numeric(x))
if (is.null(x) || length(x) == 0 || is.na(x)) "NA" else formatC(x, format = "d", big.mark = ",")
}
# Safe string helper
s <- function(x) {
x <- as.character(x)
if (is.null(x) || length(x) == 0 || is.na(x) || !nzchar(x)) "NA" else htmlEscape(x)
}
paste0(
"<div style='font-size:13px; line-height:1.4;'>",
# Settlement name (title)
"<div style='font-size:15px; font-weight:bold; margin-bottom:6px;'>",
df$village_name,
"</div>",
"<b>Monthly mean p<sub>lit</sub> (day-avg):</b> ", fmt_num(df$mean_p_lit, 3), "<br>",
"<b>Monthly p<sub>lit</sub> (n_valid-weighted):</b> ", fmt_num(df$p_lit_weighted, 3), "<br>",
"<b>Days observed:</b> ", df$n_days_obs, " / ", N_DAYS_WINDOW, " (", fmt_num(100 * df$share_days_obs, 0), "%)<br>",
"<b>Mean coverage:</b> ", fmt_num(df$mean_cov), "<br>",
"<b>Mean valid pixels:</b> ", fmt_num(df$mean_n_valid, 0), "<br>",
"<b>Reliability (share of observed days p<sub>lit</sub> ≥ ", fmt_num(LIT_TAU, 2), "):</b> ", fmt_num(df$frac_days_lit, 2), "<br>",
"<b>Share of observed days with any light:</b> ", fmt_num(df$frac_days_any_lit, 2), "<br><br>",
"<b>Population:</b> ", formatC(df$population, format = "d", big.mark = ","), "<br>",
"<b>Estimated demand (kWh/day):</b> ", fmt_num(df$demand, 1), "<br><br>",
"<b>Region:</b> ", df$admin_cgaz_1, "<br>",
"<b>District:</b> ", df$admin_cgaz_2,
"</div>"
)
}
# Precompute popup HTML once (faster + avoids evaluation edge-cases)
map_sf$popup_html <- vapply(seq_len(nrow(map_sf)), function(i) popup_settlement(map_sf[i, ]), character(1))
# -----------------------------
# 3) READ GENERATORS (POINTS)
# -----------------------------
# FIX 1: create gen_ll (not gen) because the map uses gen_ll later
gen_ll <- st_read(GEN_GPKG, layer = GEN_LAYER, quiet = TRUE) %>%
st_make_valid() %>%
st_transform(4326)
# Choose columns (best effort)
col_name  <- if ("plant_name"   %in% names(gen_ll)) "plant_name"   else if ("name" %in% names(gen_ll)) "name" else NA_character_
col_fuel  <- if ("fuel_or_tech" %in% names(gen_ll)) "fuel_or_tech" else if ("fuel" %in% names(gen_ll)) "fuel" else NA_character_
col_stat  <- if ("status"       %in% names(gen_ll)) "status"       else NA_character_
col_cap   <- if ("capacity_mw"  %in% names(gen_ll)) "capacity_mw"  else NA_character_
col_owner <- if ("owner"        %in% names(gen_ll)) "owner"        else NA_character_
col_tech  <- if ("technology"   %in% names(gen_ll)) "technology"   else NA_character_
col_start <- if ("start_year"   %in% names(gen_ll)) "start_year"   else NA_character_
col_type  <- if ("type"         %in% names(gen_ll)) "type"         else NA_character_
gen_ll$fuel_val <- if (!is.na(col_fuel) && col_fuel %in% names(gen_ll)) as.character(gen_ll[[col_fuel]]) else NA_character_
gen_ll$mk_col   <- fuel_color(gen_ll$fuel_val)
gen_ll$popup_html <- vapply(seq_len(nrow(gen_ll)), function(i) {
r <- gen_ll[i, ]
nm    <- if (!is.na(col_name))  as.character(r[[col_name]])  else "Power plant"
fuel  <- if (!is.na(col_fuel))  as.character(r[[col_fuel]])  else "Unknown"
stat  <- if (!is.na(col_stat))  as.character(r[[col_stat]])  else "Unknown"
cap   <- if (!is.na(col_cap))   suppressWarnings(as.numeric(r[[col_cap]])) else NA_real_
owner <- if (!is.na(col_owner)) as.character(r[[col_owner]]) else NA_character_
tech  <- if (!is.na(col_tech))  as.character(r[[col_tech]])  else NA_character_
sy    <- if (!is.na(col_start)) as.character(r[[col_start]]) else NA_character_
typ   <- if (!is.na(col_type))  as.character(r[[col_type]])  else NA_character_
dot <- fuel_color(fuel)
extra_lines <- character(0)
if (!is.na(typ)   && nzchar(typ))   extra_lines <- c(extra_lines, paste0("<b>Type:</b> ", htmlEscape(typ)))
if (!is.na(owner) && nzchar(owner)) extra_lines <- c(extra_lines, paste0("<b>Owner:</b> ", htmlEscape(owner)))
if (!is.na(tech)  && nzchar(tech))  extra_lines <- c(extra_lines, paste0("<b>Technology:</b> ", htmlEscape(tech)))
if (!is.na(sy)    && nzchar(sy))    extra_lines <- c(extra_lines, paste0("<b>Start year:</b> ", htmlEscape(sy)))
paste0(
"<div style='font-family: system-ui,-apple-system,Segoe UI,Roboto,Arial; font-size:14px; line-height:1.45; min-width:260px;'>",
"<div style='font-size:18px; font-weight:800; letter-spacing:1px; text-transform:uppercase; margin-bottom:10px;'>",
htmlEscape(nm),
"</div>",
"<div style='margin-bottom:6px;'>",
"<b>Fuel/Tech:</b> ",
"<span style='display:inline-block;width:10px;height:10px;border-radius:50%;background:", dot, ";margin:0 8px 0 6px;'></span>",
htmlEscape(fuel),
"</div>",
"<div style='margin-bottom:6px;'><b>Status:</b> ", htmlEscape(stat), "</div>",
"<div style='margin-bottom:10px;'><b>Capacity:</b> ",
ifelse(is.na(cap), "NA", paste0(fmt_num(cap, 1), " MW")),
"</div>",
if (length(extra_lines) > 0) paste0(paste0(extra_lines, collapse = "<br>"), "<br>") else "",
"</div>"
)
}, character(1))
# -----------------------------
# 4) READ GRID (ALREADY CLIPPED)
# -----------------------------
grid_sa <- st_read(GRID_PATH, layer = GRID_LAYER, quiet = TRUE) %>%
st_make_valid() %>%
st_transform(4326)
# -----------------------------
# 5) LEAFLET MAP
# -----------------------------
pal <- leaflet::colorNumeric(
palette = colorRampPalette(c("#5e0000", "#b30000", "#e34a33", "#fc8d59", "#fed976"))(256),
domain  = c(0, 1),
na.color = "#e0e0e0"
)
GRID_COL <- "#08306B"
m <- leaflet(options = leafletOptions(preferCanvas = TRUE)) %>%
addProviderTiles(providers$CartoDB.Positron, group = "Basemap") %>%
addPolygons(
data         = map_sf,
group        = "Settlements (mean p_lit)",
fillColor    = ~pal(mean_p_lit),
fillOpacity  = 0.75,
color        = NA,
weight       = 0,
smoothFactor = 0.2,
popup = ~popup_html
) %>%
addPolylines(
data   = grid_sa,
group  = "Grid (South Africa)",
color = GRID_COL,
weight = 1.0,
opacity = 0.55,
smoothFactor = 1
) %>%
addPolylines(
data   = sa0,
group  = "South Africa border",
color = "#000000",
weight = 1.2,
opacity = 0.85   # FIX 2: removed trailing comma
) %>%
addCircleMarkers(
data = gen_ll,
group = "Power plants",
radius = 4.5,
stroke = TRUE,
weight = 1.2,
opacity = 0.9,
color = "#FFFFFF",
fillOpacity = 0.95,
fillColor = ~mk_col,
popup = ~popup_html
) %>%
addLegend(
position = "topright",
pal      = pal,
values   = map_sf$mean_p_lit,
title    = "Monthly mean p_lit",
opacity  = 1
) %>%
addLayersControl(
overlayGroups = c("Settlements (mean p_lit)", "Power plants", "Grid (South Africa)", "South Africa border"),
options = layersControlOptions(collapsed = FALSE)
) %>%
setView(lng = 24.5, lat = -29.0, zoom = 5)
m
# -----------------------------
# 6) SAVE HTML (OPTIONAL)
# -----------------------------
htmlwidgets::saveWidget(m, OUT_HTML, selfcontained = TRUE)
cat("Saved:", OUT_HTML, "\n")
m
rm(list = ls())
suppressPackageStartupMessages({
