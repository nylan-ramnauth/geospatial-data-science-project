baseline_ok <- terra::values(lower_r, mat = FALSE)[mask_cells]
summary <- tibble::tibble(
year = year_label,
n_expected_days = length(expected_dates),
n_daily_rasters = length(tif_map),
n_missing_daily_rasters = length(missing_tif_dates),
missing_daily_raster_dates = paste(missing_tif_dates, collapse = ";"),
n_aoi_pixels = length(mask_cells),
n_baseline_pixels_ok = sum(is.finite(baseline_ok)),
lower_multiplier = lower_multiplier,
upper_multiplier = upper_multiplier,
min_required_baseline_obs = min_baseline_obs,
min_observed_baseline_obs = min(baseline_nobs, na.rm = TRUE),
median_baseline_obs = stats::median(baseline_nobs, na.rm = TRUE),
output_tif = out_tif
)
utils::write.csv(summary, out_summary, row.names = FALSE)
