paths_iqr <- pixel_iqr_paths()
dir.create(paths_iqr$baseline_dir, recursive = TRUE, showWarnings = FALSE)
start_month <- Sys.getenv("VJ146A2_START_MONTH", "2023-01")
end_month <- Sys.getenv("VJ146A2_END_MONTH", "2023-12")
year_label <- Sys.getenv("VJ146A2_YEAR", substr(start_month, 1, 4))
lower_multiplier <- pixel_iqr_env_num("VJ146A2_PIXEL_IQR_LOWER_MULTIPLIER", 1.5)
upper_multiplier <- pixel_iqr_env_num("VJ146A2_PIXEL_IQR_UPPER_MULTIPLIER", 1.5)
min_baseline_obs <- pixel_iqr_env_int("VJ146A2_PIXEL_IQR_MIN_BASELINE_OBS", 30L)
chunk_size <- pixel_iqr_env_int("VJ146A2_PIXEL_IQR_CELL_CHUNK_SIZE", 250000L)
if (!is.finite(min_baseline_obs) || min_baseline_obs <= 0) {
stop("VJ146A2_PIXEL_IQR_MIN_BASELINE_OBS must be a positive integer.")
}
mask_file <- Sys.getenv(
"VJ146A2_PIXEL_IQR_AOI_MASK",
file.path(paths_iqr$aoi_dir, paste0("vj146a2_pixel_iqr_yearlykeep_aoi_mask_", year_label, ".tif"))
)
if (!file.exists(mask_file)) stop("AOI mask not found. Run Step 2 first: ", mask_file)
tif_map <- pixel_iqr_daily_tif_map(paths_iqr$raw_daily_tif_dir, start_month, end_month)
dates <- pixel_iqr_apply_smoke_date_cap(as.Date(names(tif_map)))
tif_map <- tif_map[format(dates, "%Y-%m-%d")]
if (length(tif_map) == 0) stop("No daily rasters selected for baseline.")
mask <- terra::rast(mask_file)
mask_vals <- terra::values(mask, mat = FALSE)
mask_cells <- which(mask_vals == 1L)
if (length(mask_cells) == 0) stop("AOI mask has no cells == 1: ", mask_file)
template <- mask[[1]]
q1_r <- q3_r <- iqr_r <- lower_r <- upper_r <- nobs_r <- template
terra::values(q1_r) <- NA_real_
terra::values(q3_r) <- NA_real_
terra::values(iqr_r) <- NA_real_
terra::values(lower_r) <- NA_real_
terra::values(upper_r) <- NA_real_
terra::values(nobs_r) <- NA_real_
cell_chunks <- split(mask_cells, ceiling(seq_along(mask_cells) / chunk_size))
message("AOI pixels: ", length(mask_cells))
message("Daily rasters selected: ", length(tif_map))
message("Cell chunks: ", length(cell_chunks), " at chunk size ", chunk_size)
message("Thresholds: lower = Q1 - ", lower_multiplier, "*IQR; upper = Q3 + ", upper_multiplier, "*IQR")
message("Minimum valid baseline observations per pixel: ", min_baseline_obs)
row_quantiles <- function(mat) {
out <- t(apply(mat, 1, function(x) {
x <- x[is.finite(x)]
if (length(x) == 0) return(c(q1 = NA_real_, q3 = NA_real_, n = 0))
qs <- stats::quantile(x, probs = c(0.25, 0.75), na.rm = TRUE, names = FALSE, type = 7)
c(q1 = qs[1], q3 = qs[2], n = length(x))
}))
out
}
for (ci in seq_along(cell_chunks)) {
cells <- cell_chunks[[ci]]
rad_mat <- matrix(NA_real_, nrow = length(cells), ncol = length(tif_map))
for (di in seq_along(tif_map)) {
r <- terra::rast(unname(tif_map[[di]]))
if (!all(c("rad", "valid") %in% names(r))) {
stop("Raster missing rad/valid bands: ", basename(tif_map[[di]]))
}
rad <- terra::values(r[["rad"]], mat = FALSE)[cells]
valid <- terra::values(r[["valid"]], mat = FALSE)[cells]
rad[!(is.finite(rad) & is.finite(valid) & valid == 1)] <- NA_real_
rad_mat[, di] <- rad
}
qs <- row_quantiles(rad_mat)
q1 <- qs[, "q1"]
q3 <- qs[, "q3"]
n <- qs[, "n"]
iqr <- q3 - q1
lower <- q1 - lower_multiplier * iqr
upper <- q3 + upper_multiplier * iqr
too_few <- n < min_baseline_obs | !is.finite(iqr)
q1[too_few] <- NA_real_
q3[too_few] <- NA_real_
iqr[too_few] <- NA_real_
lower[too_few] <- NA_real_
upper[too_few] <- NA_real_
q1_r[cells] <- q1
q3_r[cells] <- q3
iqr_r[cells] <- iqr
lower_r[cells] <- lower
upper_r[cells] <- upper
nobs_r[cells] <- n
message("[", ci, "/", length(cell_chunks), "] baseline pixels processed: ", length(cells))
}
