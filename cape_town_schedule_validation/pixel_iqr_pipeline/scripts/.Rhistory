paths_iqr <- pixel_iqr_paths()
dir.create(paths_iqr$daily_state_dir, recursive = TRUE, showWarnings = FALSE)
start_month <- Sys.getenv("VJ146A2_START_MONTH", "2023-01")
end_month <- Sys.getenv("VJ146A2_END_MONTH", "2023-12")
year_label <- Sys.getenv("VJ146A2_YEAR", substr(start_month, 1, 4))
mask_file <- Sys.getenv(
"VJ146A2_PIXEL_IQR_AOI_MASK",
file.path(paths_iqr$aoi_dir, paste0("vj146a2_pixel_iqr_yearlykeep_aoi_mask_", year_label, ".tif"))
)
baseline_file <- Sys.getenv(
"VJ146A2_PIXEL_IQR_BASELINE_FILE",
file.path(paths_iqr$baseline_dir, paste0("vj146a2_pixel_iqr_threshold_baseline_", year_label, ".tif"))
)
if (!file.exists(mask_file)) stop("AOI mask not found. Run Step 2 first: ", mask_file)
if (!file.exists(baseline_file)) stop("Pixel-IQR baseline not found. Run Step 3 first: ", baseline_file)
mask <- terra::rast(mask_file)[[1]]
baseline <- terra::rast(baseline_file)
required_baseline <- c("lower_threshold", "upper_threshold")
if (!all(required_baseline %in% names(baseline))) {
stop("Baseline raster missing bands: ", paste(setdiff(required_baseline, names(baseline)), collapse = ", "))
}
lower <- baseline[["lower_threshold"]]
upper <- baseline[["upper_threshold"]]
tif_map <- pixel_iqr_daily_tif_map(paths_iqr$raw_daily_tif_dir, start_month, end_month)
month_start <- as.Date(paste0(start_month, "-01"))
month_end <- as.Date(paste0(end_month, "-01"))
analysis_end <- seq.Date(from = month_end, by = "month", length.out = 2)[2] - 1
expected_dates <- seq.Date(from = month_start, to = analysis_end, by = "day")
missing_tif_dates <- setdiff(format(expected_dates, "%Y-%m-%d"), names(tif_map))
if (length(missing_tif_dates) > 0) {
message(
"Missing raw daily rasters in requested window: ",
length(missing_tif_dates),
" day(s). No state raster will be written for those dates."
)
}
dates <- pixel_iqr_apply_smoke_date_cap(as.Date(names(tif_map)))
tif_map <- tif_map[format(dates, "%Y-%m-%d")]
overwrite <- pixel_iqr_env_bool("VJ146A2_PIXEL_IQR_OVERWRITE_STATES", FALSE)
message("Daily state rasters selected: ", length(tif_map))
message("Output directory: ", paths_iqr$daily_state_dir)
summary_rows <- vector("list", length(tif_map))
for (i in seq_along(tif_map)) {
f <- unname(tif_map[[i]])
d <- as.Date(names(tif_map)[i])
d_str <- format(d, "%Y-%m-%d")
out_tif <- file.path(paths_iqr$daily_state_dir, paste0("vj146a2_pixel_iqr_state_", d_str, ".tif"))
if (file.exists(out_tif) && !overwrite) {
message("[", i, "/", length(tif_map), "] Exists, skipping: ", out_tif)
summary_rows[[i]] <- tibble::tibble(date = d, status = "exists", output_tif = out_tif)
next
}
message("[", i, "/", length(tif_map), "] Processing ", d_str)
r <- terra::rast(f)
if (!all(c("rad", "valid") %in% names(r))) {
stop("Raster missing rad/valid bands: ", basename(f))
}
if (!terra::compareGeom(r[["rad"]], mask, stopOnError = FALSE)) {
stop("Daily raster geometry does not match AOI mask: ", basename(f))
}
rad <- r[["rad"]]
valid <- terra::ifel(is.na(r[["valid"]]), 0, terra::ifel(r[["valid"]] == 1, 1, 0))
in_aoi <- terra::ifel(mask == 1, 1, 0)
has_baseline <- terra::ifel(is.na(lower) | is.na(upper), 0, 1)
has_rad <- terra::ifel(is.na(rad), 0, 1)
valid_iqr <- terra::ifel(in_aoi == 1 & has_baseline == 1 & valid == 1 & has_rad == 1, 1, 0)
bright_excluded_iqr <- terra::ifel(valid_iqr == 1 & rad > upper, 1, 0)
observed_iqr <- terra::ifel(valid_iqr == 1 & bright_excluded_iqr == 0, 1, 0)
dark_iqr <- terra::ifel(observed_iqr == 1 & rad < lower, 1, 0)
valid_iqr <- terra::ifel(in_aoi == 1, valid_iqr, NA)
observed_iqr <- terra::ifel(in_aoi == 1, observed_iqr, NA)
dark_iqr <- terra::ifel(in_aoi == 1, dark_iqr, NA)
bright_excluded_iqr <- terra::ifel(in_aoi == 1, bright_excluded_iqr, NA)
states <- c(valid_iqr, observed_iqr, dark_iqr, bright_excluded_iqr)
names(states) <- c("valid_iqr", "observed_iqr", "dark_iqr", "bright_excluded_iqr")
terra::writeRaster(
states,
out_tif,
overwrite = TRUE,
datatype = "INT1U",
NAflag = 255,
gdal = c("COMPRESS=DEFLATE", "PREDICTOR=2")
)
summary_rows[[i]] <- tibble::tibble(date = d, status = "written", output_tif = out_tif)
}
